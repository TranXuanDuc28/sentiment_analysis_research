{
  "manifest_version": 3,
  "name": "Sentiment AI Assistant",
  "version": "1.0",
  "description": "Analyze sentiment of any page instantly.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": ["http://localhost:8000/*"]
}
